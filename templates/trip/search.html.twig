{% extends 'base.html.twig' %}

{% block title %}Search trips{% endblock %}

{% block body %}
    <h1>Find a trip</h1>

    <form method="get" action="{{ path('app_trips_search') }}">
        <label>
            From
            <select name="from">
                <option value="">— Any —</option>
                {% for city in cities %}
                    <option value="{{ city.name }}" {{ from == city.name ? 'selected' : '' }}>
                        {{ city.name }}
                    </option>
                {% endfor %}
            </select>
        </label>

        <label>
            To
            <select name="to">
                <option value="">— Any —</option>
                {% for city in cities %}
                    <option value="{{ city.name }}" {{ to == city.name ? 'selected' : '' }}>
                        {{ city.name }}
                    </option>
                {% endfor %}
            </select>
        </label>

        <label>
            Date
            <input type="date" name="date" value="{{ date }}">
        </label>

        <button type="submit">Search</button>
    </form>

    <hr>

    {% if trips is empty %}
        <p>No trips found.</p>
    {% else %}
        <h2>{{ trips|length }} trip(s)</h2>
        <ul>
            {% for trip in trips %}
                <li>
                    <strong>{{ trip.stops.first.city.name }}
                        → {{ trip.stops.last.city.name }}</strong>
                    — {{ trip.departureAt|date('Y-m-d H:i') }}
                    — {{ trip.totalSeats }} seats
                    — driver: {{ trip.driver.email }}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}